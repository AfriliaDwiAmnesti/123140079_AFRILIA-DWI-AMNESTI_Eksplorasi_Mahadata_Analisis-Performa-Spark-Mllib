import time
import numpy as np

from pyspark.sql import SparkSession
from pyspark.sql.types import (
    StructType,
    StructField,
    DoubleType
)
from pyspark.ml.feature import VectorAssembler
from pyspark.ml.classification import (
    LogisticRegression,
    RandomForestClassifier
)
from pyspark.ml.evaluation import (
    MulticlassClassificationEvaluator,
    BinaryClassificationEvaluator
)



spark = (
    SparkSession.builder
    .appName("AnalisisPerformaSparkMLlib")
    .master("local[*]")
    .config("spark.driver.memory", "4g")
    .getOrCreate()
)

spark.sparkContext.setLogLevel("ERROR")

print("=" * 65)
print("ANALISIS PERFORMA ALGORITMA KLASIFIKASI DENGAN SPARK MLlib")
print("=" * 65)



JUMLAH_DATA = 50000
JUMLAH_FITUR = 28
RANDOM_STATE = 42

np.random.seed(RANDOM_STATE)

# Membuat 28 fitur numerik secara acak
X = np.random.normal(
    loc=0.0,
    scale=1.0,
    size=(JUMLAH_DATA, JUMLAH_FITUR)
)

# Membuat label dengan rasio kelas 0: 65% dan kelas 1: 35%
jumlah_kelas_1 = int(JUMLAH_DATA * 0.35)

y = np.array(
    [1] * jumlah_kelas_1
    + [0] * (JUMLAH_DATA - jumlah_kelas_1)
)

# Mengacak urutan label
np.random.shuffle(y)

print("\nInformasi Data:")
print(f"Jumlah data       : {JUMLAH_DATA}")
print(f"Jumlah fitur      : {JUMLAH_FITUR}")
print(f"Jumlah kelas 0    : {np.sum(y == 0)}")
print(f"Jumlah kelas 1    : {np.sum(y == 1)}")
print("Sumber data       : Data sintetis")



nama_fitur = [
    f"feature_{i + 1}"
    for i in range(JUMLAH_FITUR)
]

schema = StructType(
    [
        StructField(nama, DoubleType(), False)
        for nama in nama_fitur
    ]
    + [
        StructField("label", DoubleType(), False)
    ]
)

data = [
    tuple(float(nilai) for nilai in X[i])
    + (float(y[i]),)
    for i in range(JUMLAH_DATA)
]

df = spark.createDataFrame(data, schema=schema)

print("\nContoh Data:")
df.show(5, truncate=False)

print(f"Jumlah baris DataFrame: {df.count()}")



assembler = VectorAssembler(
    inputCols=nama_fitur,
    outputCol="features"
)

data_model = assembler.transform(df).select(
    "features",
    "label"
)

data_latih, data_uji = data_model.randomSplit(
    [0.8, 0.2],
    seed=RANDOM_STATE
)

jumlah_latih = data_latih.count()
jumlah_uji = data_uji.count()

print("\nPembagian Data:")
print(f"Data latih: {jumlah_latih}")
print(f"Data uji  : {jumlah_uji}")



evaluator_accuracy = MulticlassClassificationEvaluator(
    labelCol="label",
    predictionCol="prediction",
    metricName="accuracy"
)

evaluator_f1 = MulticlassClassificationEvaluator(
    labelCol="label",
    predictionCol="prediction",
    metricName="f1"
)

evaluator_auc = BinaryClassificationEvaluator(
    labelCol="label",
    rawPredictionCol="rawPrediction",
    metricName="areaUnderROC"
)

hasil = []



print("\n" + "=" * 65)
print("PENGUJIAN LOGISTIC REGRESSION")
print("=" * 65)

model_lr = LogisticRegression(
    featuresCol="features",
    labelCol="label",
    maxIter=20,
    regParam=0.0
)

mulai_latih_lr = time.perf_counter()
trained_lr = model_lr.fit(data_latih)
waktu_latih_lr = time.perf_counter() - mulai_latih_lr

mulai_uji_lr = time.perf_counter()
prediksi_lr = trained_lr.transform(data_uji).cache()

# Memaksa evaluasi hasil transformasi
prediksi_lr.count()

accuracy_lr = evaluator_accuracy.evaluate(prediksi_lr)
f1_lr = evaluator_f1.evaluate(prediksi_lr)
auc_lr = evaluator_auc.evaluate(prediksi_lr)

waktu_uji_lr = time.perf_counter() - mulai_uji_lr
total_lr = waktu_latih_lr + waktu_uji_lr

hasil.append({
    "Algoritma": "Logistic Regression",
    "Accuracy": accuracy_lr,
    "F1-Score": f1_lr,
    "AUC": auc_lr,
    "Waktu Latih (detik)": waktu_latih_lr,
    "Waktu Uji dan Evaluasi (detik)": waktu_uji_lr,
    "Total Waktu (detik)": total_lr
})

print(f"Accuracy       : {accuracy_lr:.4f}")
print(f"F1-Score       : {f1_lr:.4f}")
print(f"AUC            : {auc_lr:.4f}")
print(f"Waktu latih    : {waktu_latih_lr:.2f} detik")
print(f"Waktu uji      : {waktu_uji_lr:.2f} detik")
print(f"Total waktu    : {total_lr:.2f} detik")

prediksi_lr.unpersist()



print("\n" + "=" * 65)
print("PENGUJIAN RANDOM FOREST")
print("=" * 65)

model_rf = RandomForestClassifier(
    featuresCol="features",
    labelCol="label",
    numTrees=20,
    maxDepth=5,
    seed=RANDOM_STATE
)

mulai_latih_rf = time.perf_counter()
trained_rf = model_rf.fit(data_latih)
waktu_latih_rf = time.perf_counter() - mulai_latih_rf

mulai_uji_rf = time.perf_counter()
prediksi_rf = trained_rf.transform(data_uji).cache()

# Memaksa evaluasi hasil transformasi
prediksi_rf.count()

accuracy_rf = evaluator_accuracy.evaluate(prediksi_rf)
f1_rf = evaluator_f1.evaluate(prediksi_rf)
auc_rf = evaluator_auc.evaluate(prediksi_rf)

waktu_uji_rf = time.perf_counter() - mulai_uji_rf
total_rf = waktu_latih_rf + waktu_uji_rf

hasil.append({
    "Algoritma": "Random Forest",
    "Accuracy": accuracy_rf,
    "F1-Score": f1_rf,
    "AUC": auc_rf,
    "Waktu Latih (detik)": waktu_latih_rf,
    "Waktu Uji dan Evaluasi (detik)": waktu_uji_rf,
    "Total Waktu (detik)": total_rf
})

print(f"Accuracy       : {accuracy_rf:.4f}")
print(f"F1-Score       : {f1_rf:.4f}")
print(f"AUC            : {auc_rf:.4f}")
print(f"Waktu latih    : {waktu_latih_rf:.2f} detik")
print(f"Waktu uji      : {waktu_uji_rf:.2f} detik")
print(f"Total waktu    : {total_rf:.2f} detik")

prediksi_rf.unpersist()



print("\n" + "=" * 100)
print("TABEL PERBANDINGAN HASIL PENGUJIAN")
print("=" * 100)

header = (
    f"{'Algoritma':<22}"
    f"{'Accuracy':>12}"
    f"{'F1-Score':>12}"
    f"{'AUC':>10}"
    f"{'Latih (s)':>13}"
    f"{'Uji (s)':>12}"
    f"{'Total (s)':>13}"
)

print(header)
print("-" * len(header))

for item in hasil:
    print(
        f"{item['Algoritma']:<22}"
        f"{item['Accuracy']:>12.4f}"
        f"{item['F1-Score']:>12.4f}"
        f"{item['AUC']:>10.4f}"
        f"{item['Waktu Latih (detik)']:>13.2f}"
        f"{item['Waktu Uji dan Evaluasi (detik)']:>12.2f}"
        f"{item['Total Waktu (detik)']:>13.2f}"
    )

tercepat = min(hasil, key=lambda item: item["Total Waktu (detik)"])

print("\nAnalisis Waktu:")
print(
    f"Algoritma dengan total waktu terendah pada "
    f"eksekusi ini adalah {tercepat['Algoritma']}."
)
print(
    "Hasil waktu dapat berbeda bergantung pada perangkat, "
    "konfigurasi, dan kondisi eksekusi."
)

print("\nCatatan:")
print(
    "Fitur dibuat secara acak dan tidak dirancang untuk "
    "memprediksi label. Oleh karena itu, nilai AUC dapat "
    "mendekati 0.50 dan hasil klasifikasi tidak menunjukkan "
    "kemampuan prediksi pada dataset nyata."
)
print(
    "Pengujian ini menggunakan Spark mode lokal, bukan "
    "klaster multi-node."
)



spark.stop()

print("\nEksperimen selesai.")
